# RelaAI v2 Environment Configuration
# Copy this file from .env.example and fill in your API keys

# AI Provider Configuration
# Supported providers: 'openai' or 'anthropic'
EXPO_PUBLIC_AI_PROVIDER=openai

# OpenAI Configuration (https://platform.openai.com/)
# Get your API key from: https://platform.openai.com/api-keys
EXPO_PUBLIC_OPENAI_API_KEY=
EXPO_PUBLIC_OPENAI_MODEL=gpt-3.5-turbo

# Anthropic Configuration (https://claude.ai/api)
# Get your API key from: https://console.anthropic.com/account/keys
EXPO_PUBLIC_ANTHROPIC_API_KEY=
EXPO_PUBLIC_ANTHROPIC_MODEL=claude-3-haiku-20240307

# Note: For development without API keys, the app will use placeholder messages
# but you won't get real AI-generated messages.
